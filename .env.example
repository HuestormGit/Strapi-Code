# =========================================================
# Local development only. Copy to .env and fill in real
# values. .env is gitignored — never commit real secrets.
# =========================================================

HOST=0.0.0.0
PORT=1337

# Selects the production-safe defaults (see the database section below).
# Strapi Cloud sets this to "production" for you.
NODE_ENV=development

# Secrets — generate your own, do not reuse these placeholders
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# --------------------------
# Database — local development
# --------------------------
# PostgreSQL is the intended local setup: the same engine Strapi Cloud runs, so
# dev and production behave the same. Create the database once before starting:
#   createdb aharasam_dev        (or: CREATE DATABASE aharasam_dev;)
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=aharasam_dev
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=
DATABASE_SSL=false
DATABASE_SCHEMA=public

# Optional — instead of the discrete vars above, a single connection URL:
# DATABASE_URL=postgres://postgres:password@localhost:5432/aharasam_dev

# Optional local SQLite fallback — supported, but not the recommended setup.
# Comment out the PostgreSQL block above and uncomment these two lines:
# DATABASE_CLIENT=sqlite
# DATABASE_FILENAME=.tmp/data.db

# With DATABASE_SSL=true, these become available (all optional):
# DATABASE_SSL_REJECT_UNAUTHORIZED=true   # set false for self-signed certs
# DATABASE_SSL_KEY=
# DATABASE_SSL_CERT=
# DATABASE_SSL_CA=
# DATABASE_SSL_CAPATH=
# DATABASE_SSL_CIPHER=

# Connection pool / timeout — defaults shown, override only if you need to:
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10
# DATABASE_CONNECTION_TIMEOUT=60000

# --------------------------
# Database — Strapi Cloud / production
# --------------------------
# Strapi Cloud's built-in managed PostgreSQL needs NO configuration here: it
# injects the connection itself at deploy time. No Neon / Supabase / Railway /
# Render / AWS RDS account is required, and no production DB server has to be
# provisioned.
#
# Do NOT copy the local DATABASE_* variables above into the Strapi Cloud
# dashboard — unless you are intentionally configuring an external database.
# Cloud injects its managed credentials only while no DATABASE_*-prefixed
# variable exists in project Variables; defining even one makes Cloud treat the
# project as using an external database and inject nothing, so the app falls
# back to localhost and the deploy fails.
#
# With NODE_ENV=production and no DATABASE_CLIENT set, the app defaults to
# postgres, so it can never silently fall back to SQLite on Cloud's
# ephemeral disk. See config/database.js.

# --------------------------
# SMTP
# --------------------------
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USERNAME=no-reply@example.com
SMTP_PASSWORD=tobemodified
SMTP_FROM=no-reply@example.com
SMTP_REPLY_TO=no-reply@example.com

# Frontend route used in password-reset emails
FRONTEND_URL=http://localhost:3000

# --------------------------
# Razorpay
# --------------------------
# API credentials, from Dashboard > Account & Settings > API Keys.
# RAZORPAY_KEY_SECRET signs the browser checkout callback and authenticates our
# server-to-server API calls (create order, fetch payment, capture).
RAZORPAY_KEY_ID=tobemodified
RAZORPAY_KEY_SECRET=tobemodified

# Webhook secret — a SEPARATE credential. This is NOT the API key secret above.
# You choose it yourself when you add the webhook in
# Dashboard > Account & Settings > Webhooks, and Razorpay uses it to sign the
# raw body of every webhook it sends us. Paste the identical string here and in
# that dashboard field; the two secrets are never interchangeable.
#
# Used only to verify POST /api/orders/razorpay/webhook. Leave it empty and that
# endpoint refuses every delivery (503) — payments still work through the
# browser callback, only the recovery path is off.
#
# Backend only. It must never appear in the frontend or in any bundle.
RAZORPAY_WEBHOOK_SECRET=

# --------------------------
# Shiprocket API user (backend only)
# --------------------------
SHIPROCKET_API_EMAIL=
SHIPROCKET_API_PASSWORD=
SHIPROCKET_API_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_PICKUP_PINCODE=

# --------------------------
# Optional — defaults shown, uncomment only to change them
# --------------------------
# WEBHOOKS_POPULATE_RELATIONS=false   # config/server.js
# FLAG_NPS=true                       # admin panel survey prompt
# FLAG_PROMOTE_EE=true                # admin panel Enterprise promo
