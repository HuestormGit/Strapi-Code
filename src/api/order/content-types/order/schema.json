{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Order",
    "description": "A placed order. All money is integer paise. subtotalMinor is TAX-INCLUSIVE: subtotalMinor = taxableBaseMinor + taxMinor, and grandTotalMinor = subtotalMinor + shippingFeeMinor."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "orderNumber": {
      "type": "string",
      "unique": true
    },
    "customer": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "customerName": {
      "type": "string"
    },
    "email": {
      "type": "email"
    },
    "phoneNumber": {
      "type": "string"
    },
    "orderItems": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::order-item.order-item",
      "mappedBy": "order"
    },
    "paymentAttempts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::payment-attempt.payment-attempt",
      "mappedBy": "order"
    },
    "currency": {
      "type": "string",
      "default": "INR",
      "maxLength": 3
    },
    "itemsMrpTotalMinor": {
      "type": "integer",
      "min": 0
    },
    "discountMinor": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "subtotalMinor": {
      "type": "integer",
      "min": 0
    },
    "taxableBaseMinor": {
      "type": "integer",
      "min": 0
    },
    "taxMinor": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "taxType": {
      "type": "enumeration",
      "enum": ["igst", "cgst_sgst", "none"]
    },
    "igstMinor": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "cgstMinor": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "sgstMinor": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "placeOfSupplyStateCode": {
      "type": "string"
    },
    "shippingFeeMinor": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "grandTotalMinor": {
      "type": "integer",
      "min": 0
    },
    "paymentStatus": {
      "type": "enumeration",
      "enum": [
        "pending",
        "processing",
        "paid",
        "failed",
        "cancelled",
        "refunded"
      ],
      "default": "pending"
    },
    "shipmentStatus": {
      "type": "enumeration",
      "enum": [
        "pending",
        "processing",
        "shipped",
        "delivered",
        "cancelled",
        "returned"
      ],
      "default": "pending"
    },
    "shippingSnapshot": {
      "type": "component",
      "repeatable": false,
      "component": "order.shipping-snapshot"
    },
    "paymentProvider": {
      "type": "enumeration",
      "enum": ["razorpay", "manual"],
      "default": "razorpay"
    },
    "paymentProviderOrderId": {
      "type": "string"
    },
    "paymentProviderPaymentId": {
      "type": "string"
    },
    "paidAt": {
      "type": "datetime"
    },
    "shipmentProvider": {
      "type": "enumeration",
      "enum": ["shiprocket", "manual"],
      "default": "shiprocket"
    },
    "shipmentProviderOrderId": {
      "type": "string"
    },
    "shipmentProviderShipmentId": {
      "type": "string"
    },
    "awbNumber": {
      "type": "string"
    },
    "trackingUrl": {
      "type": "string"
    },
    "shippedAt": {
      "type": "datetime"
    },
    "deliveredAt": {
      "type": "datetime"
    },
    "paymentAttemptCount": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "lastPaymentAttemptAt": {
      "type": "datetime"
    },
    "lastPaymentError": {
      "type": "text"
    },
    "nextPaymentRetryAt": {
      "type": "datetime"
    }
  }
}
